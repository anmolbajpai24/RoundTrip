# Copy this file to .env.local and fill in real values (never commit .env.local).
#
# Supabase — Project Settings → API. The anon key is safe to expose in the
# client bundle; it's protected by Row-Level Security. Do NOT put the
# service_role key here (or anywhere in the frontend).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Unsplash (optional) — trip cover photos. Any VITE_* var is inlined into the
# shipped JS, so this key is publicly readable in the deployed bundle. Use a
# low-tier demo key and treat it as rotatable, not secret. Omit it entirely and
# cover photos simply fall back to colour gradients.
VITE_UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ---- Virtual try-on ("See it on me") — SERVER-SIDE ONLY, no VITE_ prefix ----
# These are read by the /api/tryon serverless function (Vercel env vars in
# production, .env.local in dev) and never ship in the client bundle.
#
# HuggingFace token (free account → hf.co/settings/tokens, "read" scope).
# Optional but recommended: authenticated calls get your own free ZeroGPU
# quota (~3.5 GPU-min/day ≈ 7-14 try-ons) instead of the shared anonymous pool.
HF_TOKEN=hf_your-token
# Which try-on Space to call (default: yisol/IDM-VTON). Change if it goes down.
# HF_TRYON_SPACE=yisol/IDM-VTON
# Optional paid upgrade: set a Google AI Studio key (billing enabled) and
# try-ons switch to Gemini 2.5 Flash Image (~$0.04/image) — better quality,
# no daily quota. Leave unset to stay on the free engine.
# GEMINI_API_KEY=your-gemini-key
