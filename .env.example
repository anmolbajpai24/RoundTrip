# Copy this file to .env.local and fill in real values (never commit .env.local).
#
# Supabase — Project Settings → API. The anon key is safe to expose in the
# client bundle; it's protected by Row-Level Security. Do NOT put the
# service_role key here (or anywhere in the frontend).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Unsplash (optional) — trip cover photos. Any VITE_* var is inlined into the
# shipped JS, so this key is publicly readable in the deployed bundle. Use a
# low-tier demo key and treat it as rotatable, not secret. Omit it entirely and
# cover photos simply fall back to colour gradients.
VITE_UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ---- AI features — SERVER-SIDE ONLY, no VITE_ prefix ----
# These are read by the api/ serverless functions (Vercel env vars in
# production, .env.local in dev) and never ship in the client bundle.
#
# Google AI Studio key (free tier works — aistudio.google.com/apikey, no card).
# Powers the trip wizard's AI itinerary suggestions (/api/itinerary, model
# gemini-flash-lite-latest: highest free-tier limits, ~1,000 requests/day). If
# set while try-on is enabled, it also upgrades try-on to Gemini 2.5 Flash
# Image (paid, ~$0.04/image).
# GEMINI_API_KEY=your-gemini-key
# Override the itinerary model. Default gemini-flash-lite-latest — an alias that
# always points to the current flash-lite, so it keeps working when Google
# retires versioned model ids. Newer accounts can ONLY use the -latest aliases
# and 3.x models; pinned older ids like gemini-2.5-flash(-lite) return 404.
# GEMINI_MODEL=gemini-flash-lite-latest
#
# HuggingFace token for virtual try-on ("See it on me"), currently flagged off.
# Free account → hf.co/settings/tokens, "read" scope. Authenticated calls get
# your own free ZeroGPU quota (~3.5 GPU-min/day ≈ 7-14 try-ons).
HF_TOKEN=hf_your-token
# Which try-on Space to call (default: yisol/IDM-VTON). Change if it goes down.
# HF_TRYON_SPACE=yisol/IDM-VTON
